script/source = "extends Node3D
@onready var main: Node = get_tree().get_root().get_node(\"main\")


@export var id_hand_tracked = 201
@export var id_repere_simulateur = 102

# WIP
## recuperation de la position du centre de la roue dans le repere global a automatiser
var pos_center_wheel_left = Vector3(-0.608433, 0.286506, -0.298351)

func _ready() -> void:
	pass

func _process(_delta):

	if main:
		if main.config.get_value(\"devices.optitrack.enabled\"):
			var node_hand_tracked = main.get_node(\"optitrack\").get_node_by_id(id_hand_tracked)
			var node_repere_simulateur = main.get_node(\"optitrack\").get_node_by_id(id_repere_simulateur)
			
			if node_hand_tracked and node_repere_simulateur:
				
				var T0S = node_repere_simulateur.global_transform.affine_inverse()
				var _pos_center_wheel_left = T0S.origin + T0S.basis * pos_center_wheel_left
				
				self.global_transform = T0S * node_hand_tracked.global_transform
				
				self.position -= _pos_center_wheel_left 
				self.position += $\"..\".position_wheel_l
"

[sub_resource type="GDScript" id="GDScript_l04ny"]
script/source = "extends Node3D

@onready var main: Node = get_tree().get_root().get_node(\"main\")

func _ready() -> void:
	pass


func _process(_delta):
	if main:
		if main.player != null:
			
			var entraxe = 0.6
			var radius = 0.6
			var player_linear_speed = main.player.get_linear_speed()
			var player_angular_speed = main.player.get_angular_speed()
			
			var wheel_angular_speed = -(player_linear_speed + entraxe / 2 * player_angular_speed)/radius

			self.rotation += Vector3(wheel_angular_speed, 0, 0) * _delta
	pass
"

