[sub_resource type="GDScript" id="GDScript_mr3hu"]
script/source = "extends Node3D

@onready var main: Node = get_tree().get_root().get_node(\"main\")

func _ready() -> void:
	pass


func _process(_delta):
	if main:
		if main.player != null:
			
			var entraxe = 0.6
			var radius = 0.6
			var player_linear_speed = main.player.get_linear_speed()
			var player_angular_speed = main.player.get_angular_speed()
			
			var wheel_angular_speed = -(player_linear_speed + entraxe / 2 * player_angular_speed)/radius

			self.rotation += Vector3(wheel_angular_speed, 0, 0) * _delta
	pass
"

[sub_resource type="GDScript" id="GDScript_6lo62"]
script/source = "extends Node3D

@onready var main: Node = get_tree().get_root().get_node(\"main\")

func _ready() -> void:
	pass


func _process(_delta):
	if main:
		if main.player != null:
			
			var entraxe = 0.6
			var radius = 0.6
			var player_linear_speed = main.player.get_linear_speed()
			var player_angular_speed = main.player.get_angular_speed()
			
			var wheel_angular_speed = -(player_linear_speed - entraxe / 2 * player_angular_speed)/radius

			self.rotation += Vector3(wheel_angular_speed, 0, 0) * _delta

	pass
"

[sub_resource type="GDScript" id="GDScript_ymvtp"]
script/source = "extends Node3D

var points = []
var frame_limit = 100
var trail_size = 0.02
var trails = []
var i = 0

func _process(_delta):

	var pos_hand = $\"../hand_right\".position

	if i >= frame_limit:
		points.remove_at(0)
	points.append(pos_hand)
	i += 1

	for trail in trails:
		trail.queue_free()
	trails.clear()

	for u in range(1, len(points)):

		var alpha = float(u) / len(points)
		alpha = pow(alpha, 1.5)
		
		var trail = create_trail(points[u], alpha)
		trails.append(trail)

func create_trail(pos: Vector3, alpha: float) -> MeshInstance3D:

	var mesh = SphereMesh.new()
	mesh.radius = trail_size * alpha
	mesh.height = trail_size * 2 * alpha
	mesh.radial_segments = 8
	mesh.rings = 8
	
	var instance = MeshInstance3D.new()
	instance.mesh = mesh
	instance.position = pos + Vector3(0, 0, 0.05)
	
	var mat = StandardMaterial3D.new()
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = Color(1, 0, 0, alpha)
	instance.material_override = mat
	instance.layers = 1 << 6
	
	add_child(instance)
	return instance
"

[sub_resource type="GDScript" id="GDScript_2cpfo"]
script/source = "extends Node3D

var points = []
var frame_limit = 100
var trail_size = 0.02
var trails = []
var i = 0

func _process(_delta):

	var pos_hand = $\"../hand_left\".position

	if i >= frame_limit:
		points.remove_at(0)
	points.append(pos_hand)
	i += 1

	for trail in trails:
		trail.queue_free()
	trails.clear()

	for u in range(1, len(points)):

		var alpha = float(u) / len(points)
		alpha = pow(alpha, 1.5)
		
		var trail = create_trail(points[u], alpha)
		trails.append(trail)

func create_trail(pos: Vector3, alpha: float) -> MeshInstance3D:

	var mesh = SphereMesh.new()
	mesh.radius = trail_size * alpha
	mesh.height = trail_size * 2 * alpha
	mesh.radial_segments = 8
	mesh.rings = 8
	
	var instance = MeshInstance3D.new()
	instance.mesh = mesh
	instance.position = pos + Vector3(0, 0, -0.05)
	
	var mat = StandardMaterial3D.new()
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color = Color(1, 0, 0, alpha)
	instance.material_override = mat
	instance.layers = 1 << 5
	
	add_child(instance)
	return instance
"

