script/source = "extends Node3D

var player = 0
var linear_speed = 0

func _ready() -> void:
	 
	pass


func _process(_delta):
	
	if $\"../../player\" != null:
		linear_speed += $\"../../player\".get_angular_speed()
	
	#var wheel_velocity = $\"../../optitrack/rigid_body_2\".rotation[2]
	
	self.rotation = Vector3(linear_speed, 0, 0)
	pass
"

