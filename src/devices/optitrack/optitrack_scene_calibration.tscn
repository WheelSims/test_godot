[sub_resource type="GDScript" id="GDScript_6k3nw"]
script/source = "extends Node3D


func _ready() -> void:
	pass


func _process(_delta):
	
	
	var pos_hand_tracked = $\"../optitrack/rigid_body_0\".position
	var pos_wheel_center = $\"../optitrack/rigid_body_2\".position
	
	var pos_hand = pos_hand_tracked - pos_wheel_center
	
	var pos_wheel_right = $\"../wheel_right\".position
	self.position = Vector3(pos_hand[2]+pos_wheel_right[0]-0.08, pos_hand[1], -pos_hand[0])
	
	pass
"

