func _ready() -> void:
	
	pass


func _process(_delta):

	pos_hand_tracked = $\"../optitrack\".get_position_by_id(id_hand_tracked)
	if pos_hand_tracked != null:
		self.position = pos_hand_tracked
	
	pass
